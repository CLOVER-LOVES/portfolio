# Email Configuration
EMAIL_ADDRESS=your-email@yourdomain.com
EMAIL_PASSWORD=your-email-password
RECIPIENT_EMAIL=your-email@yourdomain.com

# SMTP Configuration
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# YouTube Data API v3
# Get an API key from Google Cloud Console and enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key
# Your YouTube Channel ID (not @handle)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxx
# Optional cache TTL (seconds)
YOUTUBE_CACHE_TTL=600
